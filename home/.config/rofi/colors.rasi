    error-container: #a0000c;
    on-error-container: #fff3f1;
    surface: #1c1108;
    on-surface: #f7dece;
    on-surface-variant: #e3c0a6;
    outline: #aa8a73;
    outline-variant: #624835;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #f7dece;
    inverse-on-surface: #3c2d23;
    inverse-primary: #9a4056;
    surface-dim: #1c1108;
    surface-bright: #47382d;
    surface-container-lowest: #160b04;
    surface-container-low: #261910;
    surface-container: #2b1e14;
    surface-container-high: #37281e;
    surface-container-highest: #423328;
