* {
    background: rgba(86, 29, 43, 0.7);
    primary: #ffb2bf;
    primary-fixed: #ffd9de;
    primary-fixed-dim: #ffb2bf;
    on-primary: #5f1129;
    on-primary-fixed: #3f0016;
    on-primary-fixed-variant: #7c293f;
    primary-container: #853046;
    on-primary-container: #fff3f3;
    secondary: #ffb2bf;
    secondary-fixed: #ffd9de;
    secondary-fixed-dim: #ffb2bf;
    on-secondary: #561d2b;
    on-secondary-fixed: #3a0717;
    on-secondary-fixed-variant: #713341;
    secondary-container: #7a3948;
    on-secondary-container: #fff3f3;
    tertiary: #ffb77f;
    tertiary-fixed: #ffdcc4;
    tertiary-fixed-dim: #ffb77f;
    on-tertiary: #4e2600;
    on-tertiary-fixed: #2f1500;
    on-tertiary-fixed-variant: #6c3a08;
    tertiary-container: #75410f;
    on-tertiary-container: #fff3ed;
    error: #ffb4ab;
